# Copy this file to .env and fill in your own values.
# Never commit .env — it is gitignored.

# Appwrite (Console → Settings → click your project)
VITE_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=

# Posts table
VITE_APPWRITE_TABLE_ID=
# Comments table
VITE_APPWRITE_COMMENT_TABLE_ID=
# Likes table
VITE_APPWRITE_LIKES_TABLE_ID=
# Saved posts table (the table's ID, not a row ID)
VITE_APPWRITE_SAVED_TABLE_ID=
# Public author profiles table: name, bio and photo for every reader
VITE_APPWRITE_PROFILES_TABLE_ID=
# Notifications table, written by the notify function (functions/notify)
VITE_APPWRITE_NOTIFICATIONS_TABLE_ID=
VITE_APPWRITE_BUCKET_ID=

# TinyMCE (tiny.cloud) — remember to add your domain to Approved Domains
VITE_TINYMCE_API_KEY=
